# =============================================================================
# Auth API - Environment Variables
# =============================================================================
# Copy this file to .env and fill in values.
# SECRETS (marked with 🔐) should NOT be committed.
# In production, use Docker secrets / GitHub Environments / vault for secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development          # development | test | production
APP_NAME="Auth API"
APP_VERSION="0.1.0"
APP_DESCRIPTION="Base FastAPI built with uv."
DEBUG=true

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Option A: Full DATABASE_URL (takes priority if set)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
# Option B: Individual DB_* parts (used if DATABASE_URL is empty)
DB_ENGINE=postgresql             # postgresql | sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_db                  # 🔐 Can also use DB_NAME_FILE=/run/secrets/db_name
DB_USER=auth_user                # 🔐 Can also use DB_USER_FILE=/run/secrets/db_user
DB_PASSWORD=                     # 🔐 Use DB_PASSWORD_FILE=/run/secrets/db_password

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS,HEAD
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Origin,Accept

# -----------------------------------------------------------------------------
# Security (🔐 = SECRET - use Docker secrets / vault in production)
# -----------------------------------------------------------------------------
SECRET_KEY="dev-only-secret-change-me"           # 🔐 Use SECRET_KEY_FILE
ALGORITHM=HS256
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
REFRESH_SECRET_KEY=""                            # 🔐 Use REFRESH_SECRET_KEY_FILE (empty = use SECRET_KEY)

# Password policy
PASSWORD_HASH_SCHEME=argon2
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_REJECT_COMMON=true

# Login rate limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_BLOCK_DURATION_MINUTES=30

# Generic request rate limiting (format: "N/timeunit")
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_REGISTER=10/minute
RATE_LIMIT_PASSWORD_RESET=5/minute
RATE_LIMIT_EMAIL_RESEND=3/minute

# Token lifetimes
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440

# Pagination
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100

# Base URL for links in emails
APP_BASE_URL=http://localhost:8001

# -----------------------------------------------------------------------------
# Redis (optional; for caching, rate limiting, and WebSocket scaling)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# -----------------------------------------------------------------------------
# Message Broker (RabbitMQ / Kafka) - optional
# -----------------------------------------------------------------------------
MESSAGE_BROKER_URL=amqp://guest:guest@localhost:5672/
MESSAGE_BROKER_TYPE=rabbitmq                    # rabbitmq | kafka
MESSAGE_BROKER_EXCHANGE=auth_events
MESSAGE_BROKER_EXCHANGE_TYPE=topic
MESSAGE_BROKER_BOOTSTRAP_SERVERS=localhost:9092
MESSAGE_BROKER_CONSUMER_GROUP=auth-api
MESSAGE_BROKER_SSL=false
MESSAGE_BROKER_SSL_CA_FILE=
MESSAGE_BROKER_SSL_CERT_FILE=
MESSAGE_BROKER_SSL_KEY_FILE=

# -----------------------------------------------------------------------------
# SMTP (optional; if SMTP_HOST empty, emails are only logged)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=                                    # 🔐 Use SMTP_PASSWORD_FILE
SMTP_FROM=
SMTP_TLS=true

# -----------------------------------------------------------------------------
# Google OAuth 2.0 / OpenID Connect
# -----------------------------------------------------------------------------
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=                                 # 🔐 Can use GOOGLE_CLIENT_ID_FILE
GOOGLE_CLIENT_SECRET=                             # 🔐 Use GOOGLE_CLIENT_SECRET_FILE
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_CERTS_URL=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_ISSUER=https://accounts.google.com
GOOGLE_STATE_TTL_MINUTES=10
GOOGLE_CERTS_CACHE_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Seed (first deploy only)
# -----------------------------------------------------------------------------
RUN_SEED_ON_STARTUP=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123                           # 🔐 Use ADMIN_PASSWORD_FILE