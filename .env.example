ENVIRONMENT=development
APP_NAME=""
APP_VERSION=""
APP_DESCRIPTION=""
DEBUG=""

DATABASE_URL=""
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

CORS_ORIGINS="*"
SECRET_KEY="dev-only-secret-change-me"
ALGORITHM=""

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Separate key for refresh tokens; if empty, SECRET_KEY is used.
REFRESH_SECRET_KEY=""

# Password policy
PASSWORD_HASH_SCHEME=argon2
PASSWORD_MIN_LENGTH=8

# Login rate limiting (failed attempts per email/IP)
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_BLOCK_DURATION_MINUTES=30

# Token lifetimes
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440

# Base URL used to build links embedded in e-mails
APP_BASE_URL=http://localhost:8001

# SMTP (optional; if SMTP_HOST is empty, e-mails are only logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
