ENVIRONMENT=development
APP_NAME=""
APP_VERSION=""
APP_DESCRIPTION=""
DEBUG=""

DATABASE_URL=""
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
# CORS methods/headers as comma-separated lists; use "*" for all.
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS,HEAD
CORS_ALLOWED_HEADERS=Authorization,Content-Type
SECRET_KEY="dev-only-secret-change-me"
ALGORITHM=""

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Separate key for refresh tokens; if empty, SECRET_KEY is used.
REFRESH_SECRET_KEY=""

# Password policy
PASSWORD_HASH_SCHEME=argon2
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_REJECT_COMMON=true

# Login rate limiting (failed attempts per email/IP)
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_BLOCK_DURATION_MINUTES=30

# Generic request rate limiting (format "N/timeunit"; units: second/minute/hour/day)
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_REGISTER=10/minute
RATE_LIMIT_PASSWORD_RESET=5/minute
RATE_LIMIT_EMAIL_RESEND=3/minute

# Token lifetimes
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440

# Pagination defaults
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100

# Base URL used to build links embedded in e-mails
APP_BASE_URL=http://localhost:8001

# SMTP (optional; if SMTP_HOST is empty, e-mails are only logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Google OAuth 2.0 / OpenID Connect login
# Enable the social login feature and register credentials at Google Cloud
# Console (APIs & Services -> Credentials -> OAuth 2.0 Client IDs -> Web app).
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match one of the authorized redirect URIs configured in the console.
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback
# Endpoints below rarely need to change.
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_CERTS_URL=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_ISSUER=https://accounts.google.com
# OAuth state token lifetime (minutes) and JWKS cache lifetime (seconds).
GOOGLE_STATE_TTL_MINUTES=10
GOOGLE_CERTS_CACHE_TTL_SECONDS=300
